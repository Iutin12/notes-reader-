{
  "name": "notera-score-reader",
  "version": "0.1.0",
  "description": "Локальный тренажёр чтения и проигрывания нот",
  "private": true,
  "main": "desktop/main.cjs",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "node --import tsx --test tests/music.test.ts",
    "test:integration": "npm run build && node --test tests/rendered-html.test.mjs",
    "desktop:dev": "electron desktop/main.cjs",
    "desktop:build:mac": "pnpm build && electron-builder --mac dmg --publish never",
    "desktop:build:win": "pnpm build && electron-builder --win nsis --x64 --publish never",
    "desktop:build:all": "pnpm build && electron-builder --mac dmg --win nsis --x64 --publish never",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@tonejs/midi": "^2.0.28",
    "drizzle-orm": "0.45.2",
    "jszip": "^3.10.1",
    "next": "16.2.6",
    "opensheetmusicdisplay": "^2.0.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "vinext": "0.0.50",
    "vite": "8.0.13"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "wrangler": "4.92.0"
  },
  "build": {
    "appId": "ru.notera.score-reader",
    "productName": "Нотера",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "!desktop/native{,/**/*}",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": "server",
        "filter": [
          "!node_modules{,/**/*}",
          "!.next{,/**/*}",
          "!release{,/**/*}",
          "!.git{,/**/*}",
          "!desktop{,/**/*}",
          "!omr-data{,/**/*}",
          "!*.log"
        ]
      },
      {
        "from": "desktop/native",
        "to": "native"
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.music"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Notera-Setup-${version}.${ext}"
    }
  },
  "type": "module"
}
